# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL where THIS backend serves the Mini App (e.g. https://tu-dominio.com)
TELEGRAM_WEBAPP_URL=
# Optional: your @username or numeric admin chat id, used for /support forwarding
TELEGRAM_ADMIN_CHAT_ID=

# ===== SERVER =====
PORT=3000
# Comma-separated list of origins allowed to call the API (leave empty to allow same-origin only)
CORS_ORIGINS=

# ===== DATABASE =====
# Path to the SQLite file. For real production scale, swap the db layer for Postgres.
DATABASE_PATH=./data/esim.db

# ===== NOWPAYMENTS =====
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
# Public HTTPS URL NOWPayments will POST IPN callbacks to, e.g. https://tu-dominio.com/api/webhooks/nowpayments
NOWPAYMENTS_IPN_URL=

# ===== ESIM PROVIDER (adapter placeholder — fill in when you pick a supplier) =====
ESIM_PROVIDER_BASE_URL=
ESIM_PROVIDER_API_KEY=

# ===== BUSINESS RULES =====
FIRST_PURCHASE_DISCOUNT_PCT=10
PHYSICAL_SIM_SHIPPING_EUR=5
PHYSICAL_SIM_MIN_QTY=3
